<?xml version="1.0" encoding="utf-8"?>
<!-- Test fixtures of the UI replay (native_gate_ui_replay_fleet, native_gate_ui_replay_min_hull, default off; driven
     only by native_gate_ui_replay_core.lua): the stock UI only orders `player` ships, the save has none with a pilot
     near the players, so the listed ships change owner at the same tick on every client; the missile run protects the
     slot ships' hull. Nothing else lives here: the orders themselves run through X4's own functions. -->
<mdscript name="X4LAN_UiReplay" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="Own" instantiate="true">
   <conditions><event_ui_triggered screen="'X4LAN_UiReplay'" control="'Own'"/></conditions>
   <actions>
    <set_value name="$ship" exact="event.param3.$ship"/>
    <do_if value="@$ship.isoperational and $ship.isclass.ship">
     <set_owner object="$ship" faction="faction.player" overridenpc="true"/>
     <debug_text text="'[X4LAN] UI_REPLAY_FLEET_OWNED ship=%s owner=%s time=%s'.[$ship.idcode, $ship.owner.id, player.age]"/>
    </do_if>
    <do_else>
     <debug_text text="'[X4LAN] UI_REPLAY_FLEET_REFUSED time=%s'.[player.age]"/>
    </do_else>
   </actions>
  </cue>
  <!-- The UI guard and the events family (native_gate_ui_guard, native_gate_ui_replay events; the scripted op ui_event): what
       reaches MD, in each client's own log. With the guard and without events nothing does; with events slot 1's arrives on
       every client at the same time, slot 2's nowhere. -->
  <cue name="GuardEvent" instantiate="true">
   <conditions><event_ui_triggered screen="'X4LAN_UiGuard'"/></conditions>
   <actions>
    <debug_text text="'[X4LAN] UI_GUARD_MD_EVENT control=%s value=%s time=%s'.[event.param2, event.param3, player.age]"/>
   </actions>
  </cue>
  <!-- native_gate_ui_replay_min_hull: the slot ships keep at least that hull percentage (the missile run's target is the
       player's own ship), set at the same tick on every client. -->
  <cue name="MinHull" instantiate="true">
   <conditions><event_ui_triggered screen="'X4LAN_UiReplay'" control="'MinHull'"/></conditions>
   <actions>
    <set_value name="$ship" exact="event.param3.$ship"/>
    <do_if value="@$ship.isoperational and $ship.isclass.ship">
     <set_object_min_hull object="$ship" exact="event.param3.$hull"/>
     <debug_text text="'[X4LAN] UI_REPLAY_MIN_HULL_SET ship=%s hull=%s time=%s'.[$ship.idcode, event.param3.$hull, player.age]"/>
    </do_if>
    <do_else>
     <debug_text text="'[X4LAN] UI_REPLAY_MIN_HULL_REFUSED time=%s'.[player.age]"/>
    </do_else>
   </actions>
  </cue>
  <!-- Test only (script op launch_stock, in every client's plan at the same tick): deployables into a slot ship's stock, so
       a scripted run can launch them (the flight family's Launch* calls). has= is what the ship then holds. -->
  <cue name="Stock" instantiate="true">
   <conditions><event_ui_triggered screen="'X4LAN_UiReplay'" control="'Stock'"/></conditions>
   <actions>
    <set_value name="$ship" exact="event.param3.$ship"/>
    <do_if value="@$ship.isoperational and $ship.isclass.ship">
     <set_value name="$macro" exact="macro.{event.param3.$macro}"/>
     <add_ammo object="$ship" macro="$macro" amount="event.param3.$amount"/>
     <debug_text text="'[X4LAN] UI_REPLAY_STOCK ship=%s macro=%s amount=%s has=%s time=%s'.[$ship.idcode, event.param3.$macro, event.param3.$amount, $ship.ammostorage.{$macro}.count, player.age]"/>
    </do_if>
    <do_else>
     <debug_text text="'[X4LAN] UI_REPLAY_STOCK_REFUSED time=%s'.[player.age]"/>
    </do_else>
   </actions>
  </cue>
  <!-- Missions and conversations (native_gate_ui_replay missions, conversation; reports/LOCKSTEP-UI-MISSIONS-20261101.txt):
       a test offer whose client is a cue actor, made from the probe's frame at the same tick on every client (script op
       mis_fixture, in every client's plan). Slot 1's accept, briefing, active mission, abort and talk then arrive here on
       every client at the same game time; slot 2's nowhere, unless missions per player is on (lockstep_mission_owners.h):
       then slot 2's accept makes the mission slot 2's, and player.entity in the accepted and the track rows is P_2 on every
       client. Rows only: every client's own log. -->
  <cue name="MissionFixture" instantiate="true" namespace="this">
   <conditions><event_ui_triggered screen="'X4LAN_UiMissions'" control="'Fixture'"/></conditions>
   <actions>
    <set_value name="$Mission" exact="this"/>
    <set_value name="$Location" exact="event.param3.$location"/>
    <create_cue_actor name="$Client" cue="this">
     <select faction="faction.argon" race="race.argon"/>
     <name name="'X4LAN Test Client'"/>
     <owner exact="faction.argon"/>
    </create_cue_actor>
    <create_offer cue="$Mission" actor="$Client" location="$Location" name="'X4LAN test offer'" description="'X4LAN UI missions test'"
                  difficulty="level.easy" faction="faction.argon" type="missiontype.fight" reward="1000Cr"/>
    <debug_text text="'[X4LAN] UI_MISSIONS_MD_OFFER cue=%s client=%s time=%s'.[$Mission, $Client, player.age]"/>
   </actions>
   <cues>
    <cue name="FixtureAccept">
     <conditions><event_object_signalled object="$Client" param="'accept'"/></conditions>
     <actions>
      <create_mission cue="$Mission" offercue="$Mission" name="'X4LAN test mission'" description="'X4LAN UI missions test'"
                      difficulty="level.easy" faction="faction.argon" type="missiontype.fight" reward="1000Cr"/>
      <set_objective cue="$Mission" step="1" action="objective.flyto" object="$Location"/>
      <remove_offer cue="$Mission"/>
      <debug_text text="'[X4LAN] UI_MISSIONS_MD_ACCEPTED offer=%s player=%s time=%s'.[event.param2, player.entity, player.age]"/>
     </actions>
     <cues>
      <!-- The mission's own checks every 5 s: whose player, ship and sector its frames see. -->
      <cue name="FixtureTrack" instantiate="true" checkinterval="5s">
       <conditions><check_value value="true"/></conditions>
       <actions>
        <debug_text text="'[X4LAN] UI_MISSIONS_MD_TRACK player=%s ship=%s sector=%s time=%s'.[player.entity, player.occupiedship, player.sector, player.age]"/>
       </actions>
      </cue>
     </cues>
    </cue>
    <cue name="FixtureDecline" instantiate="true">
     <conditions><event_object_signalled object="$Client" param="'decline'"/></conditions>
     <actions><debug_text text="'[X4LAN] UI_MISSIONS_MD_DECLINED offer=%s time=%s'.[event.param2, player.age]"/></actions>
    </cue>
    <cue name="FixtureBriefingStarted" instantiate="true">
     <conditions><event_briefing_started cue="$Mission"/></conditions>
     <actions><debug_text text="'[X4LAN] UI_MISSIONS_MD_BRIEFING started target=%s time=%s'.[event.param, player.age]"/></actions>
    </cue>
    <cue name="FixtureBriefingCancelled" instantiate="true">
     <conditions><event_briefing_cancelled cue="$Mission"/></conditions>
     <actions><debug_text text="'[X4LAN] UI_MISSIONS_MD_BRIEFING cancelled time=%s'.[player.age]"/></actions>
    </cue>
    <cue name="FixtureBriefingButton" instantiate="true">
     <conditions><event_briefing_interact_button_clicked cue="$Mission"/></conditions>
     <actions><debug_text text="'[X4LAN] UI_MISSIONS_MD_BRIEFING button time=%s'.[player.age]"/></actions>
    </cue>
    <cue name="FixtureAborted">
     <conditions><event_mission_aborted cue="$Mission"/></conditions>
     <actions>
      <remove_mission cue="$Mission" type="aborted"/>
      <debug_text text="'[X4LAN] UI_MISSIONS_MD_ABORTED time=%s'.[player.age]"/>
     </actions>
    </cue>
   </cues>
  </cue>
  <!-- Generic mission offers per slot (lockstep_mission_owners.h 'offers'): the probe signals the galaxy inside slot k's
       scope at the same tick on every client; X4's own selection (GenericMissions.Manager.EvaluateSectorMissions) then
       runs at once, in that scope, for the sector and the player of slot k. The row names the player it ran for. -->
  <cue name="SlotOffers" instantiate="true">
   <conditions><event_object_signalled object="player.galaxy" param="'x4lan_slot_offers'"/></conditions>
   <actions>
    <debug_text text="'[X4LAN] MPP_OFFERS_MD slot=%s player=%s sector=%s gms=%s limit=%s time=%s'.[event.param2, player.entity, player.sector, @md.GenericMissions.Manager.$MissionCues.count, @md.GenericMissions.Manager.$SectorLimit, player.age]"/>
    <do_if value="player.sector and not @md.GenericMissions.Manager.$Disabled">
     <signal_cue_instantly cue="md.GenericMissions.EvaluateSectorMissions"/>
    </do_if>
   </actions>
  </cue>
  <!-- The player's ship as each client's HUD knows it (native_gate_hud_ship_refresh, the probe's pilot_view.hud_ship_changed).
       X4's HUD attaches the radar (monitors.lua: SetRadarRenderTarget2 walks up from the player to its ship), the crosshair
       and the weapon panel to the player's ship once, when they are set up: at the load, before a client presents its own
       slot's player. Client 2's radar then showed slot 1's ship (user report, 9 Nov). The stock event for "the player's
       ship changed" makes both stock scripts set themselves up again; raised on every client at the same tick, each
       client's UI handles it for the player it presents. -->
  <cue name="HudShipChanged" instantiate="true">
   <conditions><event_ui_triggered screen="'X4LAN_Hud'" control="'ShipChanged'"/></conditions>
   <actions>
    <raise_lua_event name="'teleportSucceeded'"/>
    <debug_text text="'[X4LAN] HUD_SHIP_CHANGED_MD why=%s time=%s'.[event.param3, player.age]"/>
   </actions>
  </cue>
  <!-- An open slot's start money in coop (native_gate_join_start_money, the probe's pilot_view.join_money). The identity plan
       applies every slot's kit at the setup tick, also for slots nobody has taken yet, and in coop the wallet is shared: the
       host would start with the money of every start on offer. So each open slot's kit money is taken out of the wallet again
       right after the setup (hold = 1, kept here per slot) and put back ten ticks after that slot's handover (hold = 0), on
       every client at the same tick. The table is in the save: a later joiner's world knows what is still held, and a slot
       whose money was given back is not paid twice. Credits arrive whole (below 2^24: exact). -->
  <cue name="JoinMoneyState">
   <actions>
    <set_value name="$held" exact="table[]"/>
   </actions>
  </cue>
  <cue name="JoinMoney" instantiate="true">
   <conditions><event_ui_triggered screen="'X4LAN_Hud'" control="'JoinMoney'"/></conditions>
   <actions>
    <set_value name="$a" exact="event.param3"/>
    <set_value name="$key" exact="'$s' + $a.$slotname"/>
    <set_value name="$before" exact="player.money"/>
    <do_if value="$a.$hold == 1 and not @JoinMoneyState.$held.{$key} and $a.$credits gt 0 and $a.$credits lt 16777216">
     <set_value name="$amount" exact="$a.$credits * 1Cr"/>
     <do_if value="player.money ge $amount">
      <reward_player money="-$amount"/>
      <set_value name="JoinMoneyState.$held.{$key}" exact="$amount"/>
     </do_if>
    </do_if>
    <do_elseif value="$a.$hold == 0 and @JoinMoneyState.$held.{$key}">
     <reward_player money="JoinMoneyState.$held.{$key}"/>
     <remove_value name="JoinMoneyState.$held.{$key}"/>
    </do_elseif>
    <debug_text text="'[X4LAN] JOIN_MONEY slot=%s hold=%s credits=%s before=%s after=%s held=%s time=%s'.[$a.$slotname, $a.$hold, $a.$credits, ($before / 1Cr)L, (player.money / 1Cr)L, JoinMoneyState.$held.keys.count, player.age]"/>
   </actions>
  </cue>
  <!-- Test only (script op gm_limit, in every client's plan at the same tick): the generic missions' limit per sector, so a
       run in one sector can see a second player's generation make offers. -->
  <cue name="GmLimit" instantiate="true">
   <conditions><event_ui_triggered screen="'X4LAN_UiMissions'" control="'GmLimit'"/></conditions>
   <actions>
    <set_value name="md.GenericMissions.Manager.$SectorLimit" exact="event.param3"/>
    <debug_text text="'[X4LAN] MPP_GM_LIMIT limit=%s gms=%s time=%s'.[md.GenericMissions.Manager.$SectorLimit, @md.GenericMissions.Manager.$MissionCues.count, player.age]"/>
   </actions>
  </cue>
  <!-- A replayed StartConversationFromMenu (reports/LOCKSTEP-UI-MISSIONS-20261101.txt section 9): X4 starts a menu conversation
       only as the result of a closing menu, so the call from the replay's frame was ignored (m1d, m1e). The replay raises this
       event instead, on every client at the apply tick, and the same conversation starts here. MD names a conversation
       statically: the names the stock menus start (default: talking to someone; gTrade_offerselect, gMain_propertyResult: the
       player computer) and our X4LAN_Talk; any other is refused, the same on every client. The actor must be an entity: a
       cue actor (a mission's client) is one but not .exists (it is outside the universe; m1g). -->
  <cue name="ConversationStart" instantiate="true">
   <conditions><event_ui_triggered screen="'X4LAN_UiConversation'" control="'Start'"/></conditions>
   <actions>
    <set_value name="$Actor" exact="@event.param3.$actor"/>
    <set_value name="$Name" exact="@event.param3.$conversation"/>
    <set_value name="$Param" exact="@event.param3.$convparam"/>
    <do_if value="not $Actor or not @$Actor.isclass.entity">
     <debug_text text="'[X4LAN] UI_CONVERSATION_MD_REFUSED why=actor name=%s actor=%s time=%s'.[$Name, @event.param3.$actor, player.age]"/>
    </do_if>
    <do_elseif value="$Name == 'default'">
     <start_conversation actor="$Actor" conversation="default" convparam="$Param"/>
     <debug_text text="'[X4LAN] UI_CONVERSATION_MD_START name=%s actor=%s time=%s'.[$Name, $Actor, player.age]"/>
    </do_elseif>
    <do_elseif value="$Name == 'gTrade_offerselect'">
     <start_conversation actor="$Actor" conversation="gTrade_offerselect" convparam="$Param"/>
     <debug_text text="'[X4LAN] UI_CONVERSATION_MD_START name=%s actor=%s time=%s'.[$Name, $Actor, player.age]"/>
    </do_elseif>
    <do_elseif value="$Name == 'gMain_propertyResult'">
     <start_conversation actor="$Actor" conversation="gMain_propertyResult" convparam="$Param"/>
     <debug_text text="'[X4LAN] UI_CONVERSATION_MD_START name=%s actor=%s time=%s'.[$Name, $Actor, player.age]"/>
    </do_elseif>
    <do_elseif value="$Name == 'X4LAN_Talk'">
     <start_conversation actor="$Actor" conversation="X4LAN_Talk" convparam="$Param"/>
     <debug_text text="'[X4LAN] UI_CONVERSATION_MD_START name=%s actor=%s time=%s'.[$Name, $Actor, player.age]"/>
    </do_elseif>
    <do_else>
     <debug_text text="'[X4LAN] UI_CONVERSATION_MD_REFUSED why=name name=%s time=%s'.[$Name, player.age]"/>
    </do_else>
   </actions>
  </cue>
  <!-- A conversation of our own: two choices; the chosen section and every conversation's end are logged. -->
  <cue name="Talk" instantiate="true">
   <conditions><event_conversation_started conversation="X4LAN_Talk"/></conditions>
   <actions>
    <debug_text text="'[X4LAN] UI_MISSIONS_MD_TALK started actor=%s time=%s'.[event.object, player.age]"/>
    <add_player_choice text="'X4LAN choice A'" section="x4lan_talk_a" position="top_left"/>
    <add_player_choice text="'X4LAN choice B'" section="x4lan_talk_b" position="top_right"/>
   </actions>
  </cue>
  <cue name="TalkSection" instantiate="true">
   <conditions><event_conversation_next_section sectionprefix="x4lan_talk_"/></conditions>
   <actions><debug_text text="'[X4LAN] UI_MISSIONS_MD_TALK section=%s time=%s'.[event.param, player.age]"/></actions>
  </cue>
  <cue name="TalkFinished" instantiate="true">
   <conditions><event_conversation_finished/></conditions>
   <actions><debug_text text="'[X4LAN] UI_MISSIONS_MD_CONVERSATION_FINISHED actor=%s outcome=%s time=%s'.[event.object, event.param, player.age]"/></actions>
  </cue>
 </cues>
</mdscript>
